# This repo has no build step of its own. Skip dependency lifecycle scripts so a
# clean `npm install` never tries to build native deps from source (e.g. `sharp`,
# pulled in transitively by wrangler), which fails on machines without a native
# toolchain. Prebuilt platform binaries (workerd, esbuild, sharp) still resolve
# via optionalDependencies, so the Cloudflare Workers smoke test still works.
ignore-scripts=true
