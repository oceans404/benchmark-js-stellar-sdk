{
  "name": "js-stellar-sdk-benchmarks",
  "version": "0.1.0",
  "private": true,
  "description": "Bundle-size, runtime-compatibility, and performance benchmarks for @stellar/stellar-sdk (v16 RC vs v15 baseline).",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "benchmark": "node scripts/analyze.mjs",
    "smoke": "node runtime/run-all.mjs",
    "perf": "node perf/run-perf.mjs",
    "net": "node perf/run-net.mjs",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "set-versions": "node scripts/set-versions.mjs",
    "sync-versions": "node scripts/sync-versions.mjs"
  },
  "dependencies": {
    "sdk-baseline": "npm:@stellar/stellar-sdk@15.1.0",
    "sdk-candidate": "npm:@stellar/stellar-sdk@16.0.0-rc.2"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "esbuild": "^0.25.0",
    "size-limit": "^11.2.0",
    "tinybench": "^2.9.0",
    "wrangler": "^4.99.0"
  }
}
